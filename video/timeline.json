 "scenes": [
  {
   "id": "hook",
   "start": 0.0,
   "dur": 4.492,
   "audio_start": 0.45,
   "audio_dur": 3.192,
   "text": "La CAF. Les impôts. Les cerfas."
  },
  {
   "id": "problem",
   "start": 4.492,
   "dur": 9.4,
   "audio_start": 4.942,
   "audio_dur": 7.536,
   "text": "Des heures perdues. Des champs incompréhensibles. Des erreurs, des relances. Et beaucoup de gens qui abandonnent en route."
  },
  {
   "id": "reveal",
   "start": 13.892,
   "dur": 6.2,
   "audio_start": 14.342,
   "audio_dur": 3.504,
   "text": "Voici Cerfa Agent. Tu parles, il clique."
  },
  {
   "id": "how",
   "start": 20.092,
   "dur": 13.0,
   "audio_start": 20.542,
   "audio_dur": 11.352,
   "text": "Tu dictes ta demande. Gladia la transcrit. Le modèle choisit la bonne donnée. Holo regarde l'écran et localise le champ. Playwright clique, tape, et le formulaire se remplit."
  },
  {
   "id": "demo",
   "start": 33.092,
   "dur": 12.6,
   "audio_start": 33.542,
   "audio_dur": 8.784,
   "text": "L'agent ouvre le site, trouve le bon champ, et tape la bonne information. Sous tes yeux. Puis il s'arrête au récapitulatif : il attend ton feu vert."
  },
  {
   "id": "trust",
   "start": 45.692,
   "dur": 7.6,
   "audio_start": 46.142,
   "audio_dur": 5.736,
   "text": "Rien n'est envoyé sans toi. Tout est journalisé. Et dès que ça bloque, l'agent te passe la main."
  },
  {
   "id": "end",
   "start": 53.292,
   "dur": 7.0,
   "audio_start": 53.742,
   "audio_dur": 4.56,
   "text": "Cerfa Agent. L'administratif français, enfin sans friction."
  }
 ],
